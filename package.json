{
  "name": "clara-website-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir site run dev",
    "build": "pnpm --dir site run build",
    "check": "pnpm --dir site run check && node --test \"worker/*.test.js\" \"site/scripts/*.test.mjs\"",
    "dev:worker": "cf dev",
    "deploy:check": "cf deploy --mode production --dry-run",
    "media:upload": "pnpm --dir site run media:upload --"
  },
  "devDependencies": {
    "cf": "1.0.0-rc.2",
    "marked": "^18.3.0",
    "wrangler": "4.168.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.20.0"
}
